{
  "name": "@footballvanga/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "admin:hash-password": "node scripts/hash-admin-password.mjs",
    "admin:session-secret": "node scripts/generate-admin-session-secret.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "dev": "tsx watch src/index.ts",
    "import:results": "node dist/importResultsCli.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "npm run test:typecheck && node --import tsx --test test/*.test.ts",
    "test:typecheck": "tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@footballvanga/shared": "*",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0"
  }
}
